<header>
	<nav class="navbar navbar-expand-lg bg-dark fixed-top">
		<div class="container-fluid">
			<div class="logo-zoo">
				<a href="/"><img class="logo" src="{{ asset('images/header/logo-arcadia.svg') }}" alt="Logo Arcadia : un rhinocéros dans un soleil levant"></a>
			</div>
			<div class="name-zoo">
				<a class="navbar-brand mx-auto ms-lg-4 text-light" href="/">ZOO ARCADIA</a>
			</div>
			<button class="navbar-toggler border-0 p-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<svg
					xmlns="http://www.w3.org/2000/svg" viewbox="0 0 128 512">
					<!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
					<path d="M64 360a56 56 0 1 0 0 112 56 56 0 1 0 0-112zm0-160a56 56 0 1 0 0 112 56 56 0 1 0 0-112zM120 96A56 56 0 1 0 8 96a56 56 0 1 0 112 0z"/>
				</svg>
			</button>
			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav ms-auto text-end">
					<li class="nav-item">
						<a class="nav-link text-light mx-2 fs-6" href="{{ path('app_home') }}">Accueil</a>
					</li>
					<li class="nav-item">
						<a class="nav-link text-light mx-2 fs-6" href="{{ path('app_service') }}">Nos services</a>
					</li>
					<li class="nav-item">
						<a class="nav-link text-light mx-2 fs-6" href="{{ path('app_habitat') }}">Nos habitats</a>
					</li>
					<li class="nav-item">
						<a class="nav-link text-light mx-2 fs-6" href="/contact">Contact</a>
					</li>

					<li class="nav-item">
						{% if app.user %}
							{% set roles = app.user.roles %}
							{% if 'ROLE_ADMIN' in roles %}
								{% set session_path = path('admin') %}
							{% elseif 'ROLE_EMPLOYEE' in roles %}
								{% set session_path = path('app_employee') %}
							{% elseif 'ROLE_VETERINARY' in roles %}
								{% set session_path = path('app_veterinary') %}
							{% endif %}

							<a href="{{ session_path }}">Bonjour
								{{ app.user.firstName }}</a>
							<a href="{{ path('app_logout') }}">
								<button class="btn btn-light mx-lg-3 fs-6" id="btn-logout">Déconnexion</button>
							</a>
						{% else %}
							<li class="nav-item">
								<a href="{{ path('app_login') }}">
									<button class="btn btn-outline-light mx-lg-3 fs-6" href="/login" id="btn-login">Connexion</button>
								</a>
							</li>
						{% endif %}
					</li>

				</ul>
			</li>
		</div>
	</div>
</nav></header>
