<section class="table-responsive my-5 mx-md-5">
	<table class="table table-striped table-hover">
		<thead>
			<tr>
				<th scope="col">Animal</th>
				<th scope="col">Prénom</th>
				<th scope="col">Etat</th>
				<th scope="col">Nourriture</th>
				<th scope="col">Quantité (g)</th>
				<th scope="col">Date</th>
				<th scope="col">Observation</th>
				<th scope="col">Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for report in reports %}
				<tr>
					<td>{{ report.animal.breed.breedName }}</td>
					<td>{{ report.animal.animalName }}</td>
                    <td>{{ report.state.stateName }}</td>
                    <td>{{ report.foodType.foodType }}</td>
                    <td>{{ report.quantity }}</td>
					<td>{{ report.datePassage|date('d/m/Y') }}</td>
					<td>{{ report.observation }}</td>
				</tr>
			{% endfor %}

		</tbody>
	</table>
</section>
