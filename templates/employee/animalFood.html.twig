{% extends 'base.html.twig' %}

{% block title %}Nourrir les animaux
{% endblock %}

{% block body %}

	<!-- SECTION : HERO -->
	{% include 'partials/_hero.html.twig' with { title: 'Saisie de la consommation de nourriture' } %}

	<!-- SECTION : INPUT FOOD CONSO -->
	<section class="container">

		{{ form_start(form, { 'attr': { 'class': 'row g-3 m-md-5' } }) }}

		<div class="col-12 col-md-6 col-lg-4 mb-3">
			{{ form_label(form.breed) }}
			{{ form_widget(form.breed) }}
			{{ form_errors(form.breed) }}
		</div>

		<div class="col-12 col-md-6 col-lg-4 mb-3">
			{{ form_label(form.animal) }}
			{{ form_widget(form.animal) }}
			{{ form_errors(form.animal) }}
		</div>
		<div class="col-12 col-md-6 col-lg-4 mb-3">
			{{ form_label(form.dateFood) }}
			{{ form_widget(form.dateFood) }}
			{{ form_errors(form.dateFood) }}
		</div>
		<div class="col-12 col-md-6 col-lg-4 mb-3">
			{{ form_label(form.time) }}
			{{ form_widget(form.time) }}
			{{ form_errors(form.time) }}
		</div>
		<div class="col-12 col-md-6 col-lg-4 mb-3">
			{{ form_label(form.foodType) }}
			{{ form_widget(form.foodType) }}
			{{ form_errors(form.foodType) }}
		</div>
		<div class="col-12 col-md-6 col-lg-4 mb-3">
			{{ form_label(form.quantity) }}
			{{ form_widget(form.quantity) }}
			{{ form_errors(form.quantity) }}
		</div>

		<div class="text-center">
			<button type="submit" class="btn btn-black mt-3" id="btn-food-conso">Soumettre</button>
		</div>

		{% for message in app.flashes('success') %}
			<div class="alert alert-success">
				{{ message }}
			</div>
		{% endfor %}

		{{ form_end(form) }}
	</section>

	<!-- SECTION : FOOD CONSO LIST -->
	<section class="table-responsive my-5 mx-md-5">
		<table class="table table-striped table-hover">
			<thead>
				<tr>
					<th scope="col">Animal</th>
					<th scope="col">Prénom</th>
					<th scope="col">Date</th>
					<th scope="col">Heure</th>
					<th scope="col">Nourriture</th>
					<th scope="col">Quantité (g)</th>
					<th scope="col">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for food in foods %}
					<tr>
						<td>{{ food.animal.breed.breedName }}</td>
						<td>{{ food.animal.animalName }}</td>
						<td>{{ food.dateFood|date('d/m/Y') }}</td>
						<td>{{ food.time|date('H:i') }}</td>
						<td>{{ food.foodType.foodType }}</td>
						<td>{{ food.quantity }}</td>
					</tr>
				{% endfor %}

			</tbody>
		</table>
	</section>
{% endblock %}
