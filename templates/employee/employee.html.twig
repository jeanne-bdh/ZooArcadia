{% extends 'base.html.twig' %}

{% block title %}Espace Employé
{% endblock %}

{% block body %}
	<!-- SECTION : HERO -->
	{% include 'partials/_hero.html.twig' with { title: 'Espace Employé' } %}

	<!-- SECTION : EMPLOYEE -->
	<div class="sidebar d-flex flex-column flex-shrink-0 p-4 bg-light">
		<a href="{{ path('app_employee') }}" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-body-emphasis text-decoration-none">
			<i class="bi bi-house-door-fill"></i>
			<span class="fs-4">Menu</span>
		</a>
		<hr>
		<ul class="nav nav-pills flex-column mb-auto">
			<li>
				<a href="{{ path('app_review_validation') }}" class="nav-link link-body-emphasis">
					<i class="bi bi-check2-circle"></i>
					Valider les avis
				</a>
			</li>
			<li>
				<a href="{{ path('app_animal_food') }}" class="nav-link link-body-emphasis">
					<i class="bi bi-leaf-fill"></i>
					Nourrir les animaux
				</a>
			</li>
		</ul>
	</div>

	<!-- Offcanvas pour mobile -->
	<div class="d-md-none">
		<button class="btn btn-dark m-2" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
			<i class="bi bi-list"></i>
			Menu
		</button>
		<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar">
			<div class="offcanvas-header">
				<h5 class="offcanvas-title">Menu</h5>
				<button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
			</div>
			<div class="offcanvas-body">
				<ul class="nav nav-pills flex-column">
					<li>
						<a href="{{ path('app_review_validation') }}" class="nav-link">Valider les avis</a>
					</li>
					<li>
						<a href="{{ path('app_animal_food') }}" class="nav-link">Nourrir les animaux</a>
					</li>
				</ul>
			</div>
		</div>
	</div>

{% endblock %}
