{% extends 'base.html.twig' %}

{% block title %}Nos services
{% endblock %}

{% block body %}
	<!-- SECTION : HERO -->
	<section class="hero d-flex justify-content-center align-items-center">
		<h1>NOS SERVICES</h1>
	</section>

	<!-- SECTION : SERVICES -->
	<section class="container-back bg-light p-5 mx-auto">
		{% for service in services %}
			<article class="article-services">
				<div class="me-lg-4">
					<div>
						<h2 class="text-center">{{ service.serviceName }}</h2>
						<p class="text-dark text-center">
							{{ service.serviceDescription|raw }}
						</p>
					</div>
				</div>
				<img class="img-services rounded-2 d-block mx-auto" src="{{ vich_uploader_asset(service, 'imageFile') }}" alt="{{ service.serviceName }}">
			</article>
		{% endfor %}
		<article class="guided-tour my-5">
			<div class="ms-lg-4">
				<h2 class="text-center">Visite guidée des habitats
					<br>(gratuit)</h2>
				<p class="text-dark text-center">
					Plongez au cœur de la nature !
					<br>
					Conçues pour enrichir votre expérience, nos visites guidées vous offrent une perspective unique et informative sur les animaux et leur habitat.
				</p>
			</div>
			<img class="img-services rounded-2 d-block mx-auto" src="{{ asset('images/services/visite-guidee.jpg') }}" alt="Visite guidée">
		</article>
		<article class="article-services">
			<div class="me-lg-4">
				<h2 class="text-center">Visite du zoo
					<br>en petit train</h2>
				<p class="text-dark text-center">
					Transformez votre visite en une aventure relaxante et amusante !
					<br>
					Idéal pour les familles, les groupes d’amis, et ceux qui souhaitent découvrir le zoo sans effort.
				</p>
			</div>
			<img class="img-services rounded-2 d-block mx-auto" src="{{ asset('images/services/petit-train.jpg') }}" alt="Petit train">
		</article>
	</section>
{% endblock %}
