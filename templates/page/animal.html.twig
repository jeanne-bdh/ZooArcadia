{% extends 'base.html.twig' %}

{% block title %}
	{{ animal.animalName }}
{% endblock %}

{% block body %}
	<!-- SECTION : HERO -->
	{% include 'partials/_hero.html.twig' with { title: animal.breed } %}

	<!-- SECTION : ANIMAL -->
	<section class="container">
		<h2 class="text-center my-4 my-md-5">{{ animal.animalName }}</h2>
		<div class="row mb-5">
			<img class="col-12 col-md-6 w-50 rounded-5 mx-auto mx-md-0" src="{{ vich_uploader_asset(animal, 'imageFile') }}" alt="{{ animal.breed }}">
			<div class="col-12 col-md-6 d-flex flex-column justify-content-center ps-5 mt-4 mt-md-0">
				<div class="d-flex">
					<p class="animal-criteria">Espèce :</p>
					<p class="ms-2 mt-1 mt-md-0">{{ animal.breed }}</p>
				</div>
				<div class="d-flex">
					<p class="animal-criteria">Habitat :</p>
					<p class="ms-2 mt-1 mt-md-0">{{ animal.habitat }}</p>
				</div>
				<div class="d-flex flex-column justify-content-center">
					<p class="animal-criteria mb-1">Détails sur l'animal :</p>
					{{ animal.detail|raw }}
				</div>
			</div>
		</div>
	</section>
{% endblock %}
