{% extends 'base.html.twig' %}

{% block title %}{{ animal.animalName }}{% endblock %}

{% block body %}
<!-- SECTION : HERO -->
<section class="hero d-flex justify-content-center align-items-center">
    <h1>CROCODILE</h1>
</section>

<!-- SECTION : ANIMAL -->
<section class="container">
    <h2 class="text-center my-4 my-md-5">Gaby</h2>
    <div class="row">
        <img class="col-12 col-md-6 w-50 mx-auto mx-md-0" src="/assets/images/marais/animals-marais/crocodile.jpg" alt="Crocodile">
        <div class="col-12 col-md-6 d-flex flex-column justify-content-center ps-5 mt-4 mt-md-0">
            <div class="d-flex">
                <p class="animal-criteria">Espèce :</p>
                <p class="ms-2 mt-1 mt-md-0">Crocodile</p>
            </div>
            <div class="d-flex">
                <p class="animal-criteria">Race :</p>
                <p class="ms-2 mt-1 mt-md-0">Crocodile des Indes</p>
            </div>
            <div class="d-flex">
                <p class="animal-criteria">Habitat :</p>
                <p class="ms-2 mt-1 mt-md-0">Marais</p>
            </div>
        </div>
        <div class="col-12 col-md-6 d-flex flex-column justify-content-center ps-5">
            <p class="animal-criteria mb-1">Détails sur l'animal :</p>
            <p>En bonne santé</p>
            <p class="animal-criteria mt-md-2 mb-md-1">L'avis du vétérinaire :</p>
            <p>Aucun problème détecté</p>
        </div>
        <img class="col-12 col-md-6 w-50 mt-3 mb-4 my-md-5 mx-auto mx-md-0" src="/assets/images/marais/animals-marais/crocodile-2.jpg"
            alt="Crocodile">
    </div>
</section>
{% endblock %}
