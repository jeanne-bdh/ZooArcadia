{% extends 'base.html.twig' %}

{% block title %}Contact
{% endblock %}

{% block body %}
	<!-- SECTION : HERO -->
	{% include 'partials/_hero.html.twig' with { title: 'CONTACT' } %}

	<!-- SECTION : CONTACT FORM -->
	<section class="container-back bg-primary py-5 mx-auto">
		<div class="bg-tertiary w-75 mx-auto rounded-3 p-4 p-md-5 border border-dark">

			{{ form_start(form) }}

			<div class="mb-3">
				{{ form_label(form.title) }}
				{{ form_widget(form.title) }}
				{{ form_errors(form.title) }}
			</div>

			<div class="mb-3">
				{{ form_label(form.email) }}
				{{ form_widget(form.email) }}
				{{ form_errors(form.email) }}
			</div>

			<div class="mb-3">
				{{ form_label(form.message) }}
				{{ form_widget(form.message) }}
				{{ form_errors(form.message) }}
			</div>

			<div class="text-center">
				<button type="submit" id="btn-contact" class="btn btn-black mb-4">Soumettre</button>
			</div>
            
			{% for message in app.flashes('success') %}
				<div class="alert alert-success">
					{{ message }}
				</div>
			{% endfor %}

			{{ form_end(form) }}

		</div>
	</section>
{% endblock %}
