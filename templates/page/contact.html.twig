<!-- SECTION : HERO -->
{% include 'partials/_hero.html.twig' with { title: 'CONTACT' } %}

<!-- SECTION : CONTACT FORM -->
<section class="container-back bg-primary py-5 mx-auto">
    <div class="bg-tertiary w-75 mx-auto rounded-3 p-4 p-md-5 border border-dark">
        <form>
            <div class="mb-3">
                <label for="inputTitleContact" class="form-label">Titre :</label>
                <input type="text" name="title" class="form-control" id="inputTitleContact" placeholder="Sujet" required></input>
                <div class="invalid-feedback">
                    Veuillez entrer un titre ayant au moins 5 caractères
                </div>
            </div>
            <div class="mb-3"">
                <label for="inputEmailContact" class="form-label">Email :</label>
                <input type="email" name="emailform" class="form-control" id="inputEmailContact"
                    placeholder="votre-email@mail.com" required></input>
                <div class="invalid-feedback">
                    Veuillez entrer une adresse e-mail valide
                </div>
                <div class="valid-feedback">
                        L'adresse e-mail est valide
                    </div>
            </div>
            <div class="mb-3">
                <label for="FormControlMessageContact" class="form-label">Message :</label>
                <textarea class="form-control" name="message" id="FormControlMessageContact" rows="py-3"
                    placeholder="Bonjour..."></textarea>
                <div class="invalid-feedback">
                    Veuillez entrer un message ayant au moins 20 caractères
                </div>
            </div>
            <div class="text-center">
                <button type="submit" id="btn-contact" class="btn btn-black">Soumettre</button>
            </div>
        </form>
    </div>
</section>