{% extends 'base.html.twig' %}

{% block title %}Nos habitats
{% endblock %}

{% block body %}
	<!-- SECTION : HERO -->
	<section class="hero d-flex justify-content-center align-items-center">
		<h1>NOS HABITATS</h1>
	</section>

	<!-- SECTION : HABITATS -->
	<section class="container d-flex flex-column my-4 mx-auto">
		{% for habitat in habitats %}
			<article class="d-flex flex-column align-items-center mb-4">
				<a class="text-black" href="/savane">
					<h3>{{ habitat.habitatName }}</h3>
				</a>
				<div class="text-center">
					<a href="/savane">
						<img class="w-50 object-fit-cover rounded-circle" src="{{ vich_uploader_asset(habitat, 'imageFile') }}" alt="{{ habitat.habitatName }}">
					</a>
				</div>
			</article>
		{% endfor %}
	</section>
{% endblock %}
