{% extends 'base.html.twig' %}

{% block title %}Nos habitats{% endblock %}

{% block body %}
<!-- SECTION : HERO -->
<section class="hero d-flex justify-content-center align-items-center">
    <h1>NOS HABITATS</h1>
</section>

<!-- SECTION : HABITATS -->
<section class="container d-flex flex-column my-4 my-md-5 mx-auto px-5">
    <div class="text-center text-sm-start">
        <div>
            <a class="text-black" href="/savane">
                <h3 class="h3-left">SAVANE</h3>
            </a>
            <a href="/savane">
                <img class="w-50 object-fit-cover rounded-circle" src="{{ asset('images/home/habitats/savane-home.jpg') }}"
                    alt="Habitat Savane">
            </a>
        </div>
        <div class="text-md-end my-4 my-md-5">
            <a class="text-black" href="/jungle">
                <h3 class="h3-right">JUNGLE</h3>
            </a>
            <a href="/jungle"><img class="w-50 object-fit-cover rounded-circle"
                    src="{{ asset('images/home/habitats/jungle-home.jpg') }}" alt="Habitat Jungle">
            </a>
        </div>
        <div>
            <a class="text-black" href="/marais">
                <h3 class="h3-left">MARAIS</h3>
            </a>
            <a href="/marais"><img class="w-50 object-fit-cover rounded-circle"
                    src="{{ asset('images/home/habitats/marais-home.jpg') }}" alt="Habitat Marais">
            </a>
        </div>
    </div>
</section>
{% endblock %}
