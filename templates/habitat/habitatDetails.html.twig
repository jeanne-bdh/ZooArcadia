{% extends 'base.html.twig' %}

{% block title %}
	{{ habitat.habitatName }}
{% endblock %}

{% block body %}
	<!-- SECTION : HERO -->
	{% include 'partials/_hero.html.twig' with { title: habitat.habitatName } %}

	<!-- SECTION : HABITAT DETAILS -->
	<section class="container">
		<div class="text-dark text-center m-4 p-md-4">
			{{ habitat.habitatDescription|raw }}
		</div>
		<div class="row my-5 mx-3">
			<img class="col rounded-5" src="{{ vich_uploader_asset(habitat, 'imageFile') }}" alt="{{ habitat.habitatName }}">
		</div>
		<p class="fs-2 ms-3">Nos animaux :</p>
		<div class="row mx-4 mb-5 g-5">
			{% for animal in habitat.animals %}
				<div class="col-12 col-md-6 col-lg-4">
					<a href="{{ path('app_animal', {'id': animal.id}) }}">
						<img class="img-animal object-fit-cover rounded-circle" src="{{ vich_uploader_asset(animal, 'imageFile') }}" alt="{{ animal.breed }}">
					</a>
					<a class="fs-4 ms-2" href="{{ path('app_animal', {'id': animal.id}) }}">{{ animal.breed }}</a>
				</div>
			{% endfor %}
		</div>
	</section>
{% endblock %}
