{% extends 'base.html.twig' %}

{% block title %}{{ habitat.habitatName }}{% endblock %}

{% block body %}
<!-- SECTION : HERO -->
<section class="hero d-flex justify-content-center align-items-center">
    <h1>{{ habitat.habitatName }}</h1>
</section>

<!-- SECTION : HABITAT DETAILS -->
<section class="container">
    <p class="text-dark text-center m-4 p-md-4">
        {{ habitat.habitatDescription|raw }}
    </p>
    <div class="row mb-5 mx-3">
        <img class="col-12 col-md-4 rounded-5" src="/assets/images/savane/savane-3.jpg" alt="Savane coucher de soleil">
        <img class="col-12 col-md-4 my-5 my-md-0 rounded-5" src="/assets/images/savane/savane-1.jpg" alt="Savane hautes herbes">
        <img class="col-12 col-md-4 rounded-5" src="/assets/images/savane/savane-2.jpg" alt="Savane arbres">
    </div>
    <p class="fs-2 ms-3">Nos animaux de la savane :</p>
    <div class="row mx-4 mb-5 g-5">
        <div class="col-12 col-md-6 col-lg-4">
            <a href="#"><img class="img-animal object-fit-cover rounded-circle" src="/assets/images/savane/animals-savane/babouin.jpg" alt="Babouins"></a>
            <a class="fs-4 ms-2" href="#">Babouins</a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a href="#"><img class="img-animal object-fit-cover rounded-circle" src="/assets/images/savane/animals-savane/elephant.jpg" alt="Eléphant"></a>
            <a class="fs-4 ms-2" href="#">Eléphants</a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a href="#"><img class="img-animal object-fit-cover rounded-circle" src="/assets/images/savane/animals-savane/girafe.jpg" alt="Girafes"></a>
            <a class="fs-4 ms-2" href="#">Girafes</a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a href="#"><img class="img-animal object-fit-cover rounded-circle" src="/assets/images/savane/animals-savane/lion.jpg" alt="Lion"></a>
            <a class="fs-4 ms-2" href="#">Lions</a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a href="#"><img class="img-animal object-fit-cover rounded-circle" src="/assets/images/savane/animals-savane/rhinoceros.jpg" alt="Rhinocéros"></a>
            <a class="fs-4 ms-2" href="#">Rhinocéros</a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a href="#"><img class="img-animal object-fit-cover rounded-circle" src="/assets/images/savane/animals-savane/zebre.jpg" alt="Zèbre"></a>
            <a class="fs-4 ms-2" href="#">Zèbres</a>
        </div>
    </div>
</section>
{% endblock %}
